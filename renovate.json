{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Version in spec files annotated with a '# renovate:' comment",
      "managerFilePatterns": ["/\\.spec$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nVersion:\\s*(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
